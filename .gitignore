# Xcode
build/
build-device/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcresult

# The project file is generated from project.yml by XcodeGen.
# Any generated project, not one named for the app: a rename un-ignores the
# old name, and `git add -A` will then sweep the stale one into a commit.
*.xcodeproj/

.DS_Store

# SwiftPM
.build/
.swiftpm/
Packages/*/.build/

# Factory: transient run state, locks, logs, escalations, per-worktree DerivedData.
.claude/factory/state/
.dd/
